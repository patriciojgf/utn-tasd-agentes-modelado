# Copiar este archivo como .env y completarlo. El .env es personal: no lo compartan.

# Agente: claude (Claude Code, el del experimento original) o gemini (Gemini CLI).
AGENTE=claude

# Modelo del agente, con su nombre completo (no un alias como "sonnet"). El mismo para
# todas las corridas. Con Claude: verlo abriendo `claude` y escribiendo /model
# (por ejemplo claude-sonnet-5-5). Con Gemini: gemini-3-flash-preview para probar, o
# gemini-3.1-pro-preview para repetir la comparación (la lista completa sale con /model
# dentro de Gemini).
MODELO=

# ---- Si AGENTE=claude, usar UNA de estas dos y dejar la otra comentada.
# Opción 1, cuenta Pro/Max: en la Mac correr `claude setup-token` y pegar el token acá.
CLAUDE_CODE_OAUTH_TOKEN=
# Opción 2, clave de API (se cobra por uso):
# ANTHROPIC_API_KEY=

# ---- Si AGENTE=gemini: clave de API de Google AI Studio (https://aistudio.google.com/apikey).
# El login con cuenta de Google ya no funciona en Gemini CLI para cuentas personales.
# GEMINI_API_KEY=
