# Copiar este archivo como .env y completarlo. El .env es personal: no lo compartan.

# Modelo del agente, con su nombre completo (no un alias como "sonnet"): verlo en la Mac
# abriendo `claude` y escribiendo /model. El mismo para todas las corridas.
MODELO=

# Autenticación: usar UNA de las dos opciones y dejar la otra comentada.
# Opción 1, cuenta Pro/Max: en la Mac correr `claude setup-token` y pegar el token acá.
CLAUDE_CODE_OAUTH_TOKEN=
# Opción 2, clave de API (se cobra por uso):
# ANTHROPIC_API_KEY=
